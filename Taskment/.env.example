# ============================================================
# .env.example — Backend Environment Variables
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG COMMIT file .env vào Git (đã có trong .gitignore)
# ============================================================

# --- Database (AWS RDS MySQL) ---
# Lấy endpoint từ: AWS Console → RDS → Databases → [tên DB] → Connectivity & security
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=taskment
DB_USERNAME=taskment_user
# Trên production: lấy từ AWS Secrets Manager, không điền tay
DB_PASSWORD=your-strong-password-here

# --- AWS Configuration ---
AWS_REGION=ap-southeast-1
# Tên S3 bucket chứa file đính kèm
S3_BUCKET_NAME=taskment-attachments-prod

# --- JWT Secret (dùng để ký access token) ---
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-512-bits

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email (Amazon SES hoặc Gmail SMTP) ---
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-ses-smtp-username
SMTP_PASSWORD=your-ses-smtp-password

# --- AI Integration ---
GEMINI_API_KEY=your-gemini-api-key

# --- Frontend URL (dùng cho CORS và redirect) ---
# Local: http://localhost:3000
# Production: https://taskment.yourdomain.com
FRONTEND_URL=http://localhost:3000

# --- CORS Allowed Origins (phân cách bằng dấu phẩy) ---
# Local: http://localhost:3000,http://localhost:3001
# Production: https://taskment.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# HƯỚNG DẪN DEPLOY LÊN AWS
# ============================================================
# Trên ECS Fargate, các biến này được cấu hình tại:
#   → AWS Console → ECS → Task Definitions → [task] → Environment variables
#
# Khuyến nghị: Dùng AWS Secrets Manager cho các giá trị nhạy cảm:
#   DB_PASSWORD, JWT_SECRET, SMTP_PASSWORD, GEMINI_API_KEY
#   → Secrets Manager tự inject vào container, không lộ trong task definition

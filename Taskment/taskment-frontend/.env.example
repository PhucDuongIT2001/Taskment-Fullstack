# ============================================================
# .env.example — Frontend Environment Variables
# Sao chép file này thành .env.local và điền giá trị thật
# KHÔNG COMMIT file .env.local vào Git
# ============================================================

# --- Backend API URL ---
# Local development:
REACT_APP_API_URL=http://localhost:8888/api

# Production (sau khi deploy lên AWS):
# REACT_APP_API_URL=https://api.taskment.yourdomain.com/api

# --- WebSocket URL ---
# Local development:
REACT_APP_WS_URL=http://localhost:8888/ws

# Production:
# REACT_APP_WS_URL=wss://api.taskment.yourdomain.com/ws

# --- Google OAuth2 Client ID (public, an toàn để commit nếu cần) ---
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
